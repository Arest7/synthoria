# Database Connection (Docker default service name is 'db')
DATABASE_URL="postgresql://admin:admin_secure_password@db:5432/artistic_education?schema=public"

# Authentication
JWT_SECRET="super-secret-jwt-key-change-this-in-production-123456"

# Storage Configuration ('local' or 's3')
STORAGE_TYPE="local"
UPLOAD_DIR="./public/uploads"

# S3 Configuration (Used only if STORAGE_TYPE="s3")
S3_ENDPOINT="https://your-supabase-id.supabase.co/storage/v1/s3"
S3_ACCESS_KEY="your-s3-access-key"
S3_SECRET_KEY="your-s3-secret-key"
S3_BUCKET="artistic-education-assets"
S3_REGION="us-east-1"
